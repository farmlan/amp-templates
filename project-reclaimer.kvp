Meta.DisplayName=Project Reclaimer
Meta.Description=Project Reclaimer (Halo 3: MCC) dedicated server. Windows build under Wine in an AMP container, like the official Docker image. One AMP instance per server.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=SunnyDan
Meta.URL=https://projectreclaimer.dev/host
Meta.DisplayImageSource=steam:976730
Meta.EndpointURIFormat={ip}:{GenericModule.App.Ports.$GamePort}
Meta.ConfigManifest=project-reclaimerconfig.json
Meta.MetaConfigManifest=project-reclaimermetaconfig.json
Meta.ConfigRoot=project-reclaimer.kvp
Meta.MinAMPVersion=2.4.6.6
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=True
Meta.ContainerPolicy=RecommendedOnLinux
Meta.ContainerPolicyReason=The Reclaimer server is a Windows program. The container provides Wine and Xvfb, as the official Reclaimer image does, without installing them on the host.
Meta.ExtraSetupStepsURI=https://github.com/farmlan/amp-templates#project-reclaimer
Meta.Prerequisites=[]
Meta.ConfigReleaseState=NotSpecified
Meta.ConfigVersion=1
Meta.AppConfigId=b513df38-ab0b-43be-a0d3-0b0f9004df38
Meta.AppIsMultiIPAware=False
App.DisplayName=Project Reclaimer
App.RootDir=./reclaimer/
App.BaseDirectory=./reclaimer/server/
App.ExecutableWin=
App.ExecutableLinux=/bin/bash
App.WorkingDir=server
App.LinuxCommandLineArgs=reclaimer-run.sh run port={{$GamePort}}
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=45
App.ExitString=exit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[project-reclaimerports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=127
App.UseRandomAdminPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[project-reclaimerupdates.json]
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.MonitorChildProcess=True
App.MonitorChildProcessName=^.*project-reclaimer\.exe dedicated *$
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=Immediate
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^$
Console.AppReadyRegex=^$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
