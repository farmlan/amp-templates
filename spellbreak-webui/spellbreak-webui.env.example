# Copy to /etc/spellbreak-webui.env (chmod 600) and fill in.
AMP_URL=http://127.0.0.1:8080
# Dedicated AMP user with access to the Spellbreak instance only
AMP_USER=spellbreak-webui
AMP_PASS=
AMP_INSTANCE=Spellbreak01
# PIN for the admin section of the web UI
ADMIN_PIN=
# Address shown to players on the join page
SERVER_ADDR=192.168.5.15
PORT=8095
